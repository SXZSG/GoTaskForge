# Copy to .env before running Docker Compose (never commit real passwords).
# Use alphanumeric passwords in MySQL DSN. URL-encode special characters if needed.
MYSQL_ROOT_PASSWORD=replaceRootPassword123
MYSQL_PASSWORD=replaceUserPassword123
TASKFORGE_API_KEY=replaceWithLongRandomKey123456789

# Default mock is free, fast, and offline after images are built.
PROVIDER=mock
# Optional OpenAI-compatible API:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

WORKERS=4
MAX_PENDING=100
MAX_ATTEMPTS=3
TASK_TIMEOUT_SEC=30
RATE_PER_MINUTE=60

# Local Go execution without Docker uses these defaults automatically:
# ADDR=127.0.0.1:8080
# STORAGE_BACKEND=file
# DATA_FILE=./data/jobs.json
# REDIS_URL=
# API_KEY=

# Go v3 inference gateway: multiple OpenAI-compatible upstream base URLs
# Default docker compose uses free, deterministic mock services.
GATEWAY_MAX_PER_BACKEND=4
GATEWAY_TIMEOUT_SEC=90
GATEWAY_FAILURE_THRESHOLD=3
GATEWAY_COOLDOWN_SEC=15
# For a live provider set GATEWAY_BACKENDS and (if needed) GATEWAY_UPSTREAM_KEY.
# Keep secrets only in your local .env; do not commit.
GATEWAY_UPSTREAM_KEY=
