# Normalize line endings so Linux/Docker/CI consumers always see LF.
* text=auto eol=lf

# Windows-only helpers are still fine with LF, but keep them explicit.
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.exe binary
